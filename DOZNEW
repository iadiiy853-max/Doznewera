# Service short name (no emoji)
APP_INFO = {
    "instagram": "IG",
    "google":    "GG",
    "twitter":   "TW",
}


def get_short_name(service_name):
    """Get short service name from full name."""
    key = str(service_name).lower()
    for name, short in APP_INFO.items():
        if name in key:
            return short
    return "UN"


def get_country_info(phone_number):
    """Extract country info from phone number."""
    if not phone_number.startswith('+'):
        phone_number = '+' + phone_number
    try:
        parsed = phonenumbers.parse(phone_number)
        region = phonenumbers.region_code_for_number(parsed)
        if region:
            flag = chr(ord(region[0]) + 127397) + chr(ord(region[1]) + 127397)
        else:
            flag = "🏳️"
        iso = region or "UN"
        return "Unknown", flag, iso
    except Exception:
        return "Unknown", "🏳️", "UN"


def extract_otp(msg):
    """Extract OTP from message."""
    otp_match = re.search(r'\d{3}[-\s]?\d{3,4}|\d{4,8}', msg)
    return otp_match.group(0) if otp_match else 'Unknown'


def mask_number(phone_number):
    """Mask phone number for privacy."""
    if len(phone_number) >= 4:
        return phone_number[:-4] + "****"
    return "****"


def make_uid(item):
    """Create unique ID from OTP entry."""
    try:
        return hash((item[0], item[1], item[2]))
    except (TypeError, IndexError):
        return hash(str(item))


async def fetch_otps(session):
    """Fetch OTPs from API."""
    try:
        async with session.get(API_URL, timeout=aiohttp.ClientTimeout(total=15)) as resp:
            if resp.status == 200:
                raw = await resp.json(content_type=None)
                if isinstance(raw, dict):
                    return raw.get("data", [])
                return raw
            else:
                print(f"⚠️ API returned status {resp.status}")
                return []
    except asyncio.TimeoutError:
        print("⚠️ API fetch timed out")
        return []
    except Exception as e:
        print(f"⚠️ Error fetching API: {e}")
        return []

async def send_to_group(bot, entry):
    """Send OTP message to group."""
    service = entry[0]
    num = entry[1]
    msg = entry[2]

    country_name, flag, iso = get_country_info(num)
    short_name = get_short_name(service)
    masked = mask_number(num)
    otp = extract_otp(msg)

    # Header: flag countrycode shortname maskednum
    text = f"{flag} <b>#{iso} #{short_name} {masked}</b>"

    # Row 1: OTP full width
    if CopyTextButton:
        try:
            btn_otp = InlineKeyboardButton(text=f"🔑 {otp}", copy_text=CopyTextButton(text=otp))
        except:
            btn_otp = InlineKeyboardButton(text=f"🔑 {otp}", callback_data="noop")
    else:
        btn_otp = InlineKeyboardButton(text=f"🔑 {otp}", callback_data="noop")
    
    markup = InlineKeyboardMarkup([[btn_otp]])

    try:
        await bot.send_message(
            chat_id=GROUP_ID,
            text=text,
            parse_mode=ParseMode.HTML,
            reply_markup=markup,
            disable_web_page_preview=True
        )
        print(f"✅ Sent OTP for {num} - {short_name}")
    except Exception as e:
        print(f"❌ Failed to send to group: {e}")

async def main():
    """Main bot loop."""
    bot = Bot(token=BOT_TOKEN)
    seen_otps = set()

    print("🚀 Starting Forwarder Bot...")
    
    async with aiohttp.ClientSession() as session:
        initial = await fetch_otps(session)
        for item in initial:
            seen_otps.add(make_uid(item))
        print(f"📦 Initialized with {len(seen_otps)} existing OTPs.")

        while True:
            await asyncio.sleep(POLL_INTERVAL)

            resp = await fetch_otps(session)
            if not resp:
                continue

            new_items = []
            for item in resp:
                uid = make_uid(item)
                if uid not in seen_otps:
                    seen_otps.add(uid)
                    new_items.append(item)

            for item in reversed(new_items):
                await send_to_group(bot, item)
                await asyncio.sleep(0.5)

            if new_items:
                print(f"📨 Forwarded {len(new_items)} new OTP(s)")

            if len(seen_otps) > 10000:
                seen_otps = set(list(seen_otps)[-5000:])


if __name__ == "__main__":
    asyncio.run(main())
